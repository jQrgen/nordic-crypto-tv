        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "标题 © %@。摘要由 Nordic Crypto 团队撰写。不构成投资建议。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शीर्षक © %@। सारांश: Nordic Crypto टीम। यह निवेश सलाह नहीं है।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Titular © %@. Resumen del equipo de Nordic Crypto. No constituye asesoramiento de inversión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Titre © %@. Résumé rédigé par l'équipe Nordic Crypto. Ne constitue pas un conseil en investissement."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "العنوان © %@. الملخص من إعداد فريق Nordic Crypto. لا يُعدّ نصيحة استثمارية."
