        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Manchete © %@. Resumo da equipe Nordic Crypto. Não constitui recomendação de investimento."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заголовок © %@. Краткое содержание подготовлено командой Nordic Crypto. Не является инвестиционной рекомендацией."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "سرخی © %@۔ خلاصہ: Nordic Crypto ٹیم۔ یہ سرمایہ کاری کا مشورہ نہیں ہے۔"
